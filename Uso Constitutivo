# UC CHAYPARA - Blaney-Criddle
# HP Prime MicroPython
# Cada linea max 40 chars
# DATOS (4 valores por fila)
M1=["Ene","Feb","Mar","Abr","May","Jun"]
M2=["Jul","Ago","Set","Oct","Nov","Dic"]
MESES=M1+M2
T=[20.75,19.17,19.27,20.17]
T+=[19.40,18.71,18.64,19.24]
T+=[21.18,23.35,23.90,22.85]
pp=[8.9778,7.9382,8.5424]
pp+=[8.0466,8.0808,7.7298]
pp+=[8.0222,8.1956,8.1576]
pp+=[8.6572,8.6354,9.0164]
P=[78.60,70.20,62.91,29.31]
P+=[9.60,5.31,3.51,7.60]
P+=[20.40,26.51,34.00,49.71]
D=[31,28,31,30,31,30]
D+=[31,31,30,31,30,31]
AT=13.0
E=0.5
RD=0.60
AC=AT/7
NOM=["AjiCap","AjiPiq","Alfalfa"]
NOM+=["Maiz","Arveja","Tomate","Mango"]
EC=[1.0,0.5,0.5,0.5,0.5,0.5,0.5]
K0=[0.95,0.90,0,0,0,0]
K0+=[0,0,0,0.60,0.85,1.05]
K1=[0.95,0.90,0,0,0,0]
K1+=[0,0,0,0.60,0.85,1.05]
K2=[0.40,0.40,0.40,0.40,0.40,0.70]
K2+=[0.95,0.95,0.95,0.95,0.70,0.40]
K3=[1.20,0.60,0.50,0.30,0.60,1.20]
K3+=[1.20,0.70,0.30,0.30,0.70,1.10]
K4=[0.70,0.30,0,0,0.30,0.70]
K4+=[1.10,0.70,0.30,0.30,0.70,1.10]
K5=[0.90,0.80,0,0,0.60,0.80]
K5+=[1.50,0.90,0.80,0.60,0.80,1.15]
K6=[0.90,0.90,0.90,0.95,1.0,1.05]
K6+=[1.10,1.10,1.10,1.05,1.0,0.90]
K=[K0,K1,K2,K3,K4,K5,K6]
# CALCULOS
def Pef(m):
    return 0.75*P[m]
def Uc(c,m):
    v=K[c][m]*pp[m]
    return v*(8.12+0.45*T[m])
def DN(c,m):
    v=Uc(c,m)-Pef(m)
    return v/EC[c]
def Qc(c,m):
    v=DN(c,m)*AC*10.0
    return v/(D[m]*86400.0)
def Qt(m):
    s=0.0
    for c in range(7):
        s+=Qc(c,m)
    return s
def Qr(m):
    return Qt(m)/RD
# FORMATO
def rj(v,w):
    s=str(v)
    n=w-len(s)
    if n>0:
        s=" "*n+s
    return s[:w]
def lj(v,w):
    s=str(v)
    n=w-len(s)
    if n>0:
        s=s+" "*n
    return s[:w]
def flt(v,d):
    f=round(v,d)
    s=str(f)
    if "." not in s:
        s+="."+("0"*d)
    else:
        a=s.split(".")
        b=(a[1]+("0"*d))[:d]
        s=a[0]+"."+b
    return s
def sep():
    print("-"*26)
def pausa():
    input("[Enter]...")
# MENU
def menu():
    op=""
    while op!="0":
        print()
        print("=== UC CHAYPARA ===")
        print("1.Parametros")
        print("2.Uc cultivo(mm)")
        print("3.Demanda neta")
        print("4.Caudal Q(lps)")
        print("5.Resumen mensual")
        print("6.Caudal max")
        print("0.Salir")
        sep()
        op=input("Opcion:")
        if op=="1":
            v_param()
        elif op=="2":
            v_uc()
        elif op=="3":
            v_dn()
        elif op=="4":
            v_qc()
        elif op=="5":
            v_res()
        elif op=="6":
            v_qmax()
    print("Fin.")
def elegir():
    print()
    for i in range(7):
        print(str(i+1)+"."+NOM[i])
    c=input("Cultivo(1-7):")
    ok=["1","2","3","4","5","6","7"]
    if c in ok:
        return int(c)-1
    print("Invalido.")
    return -1
def v_param():
    print()
    print("PARAM CLIMATICOS")
    sep()
    print("Mes T(C)  P(mm)")
    sep()
    for m in range(12):
        a=lj(MESES[m],4)
        b=rj(flt(T[m],2),5)
        c=rj(flt(P[m],1),6)
        print(a+" "+b+" "+c)
    sep()
    s="Area:"+str(AT)+" Ha"
    print(s)
    s="E:"+str(int(E*100))+"%"
    s+=" Rend:"+str(int(RD*100))+"%"
    print(s)
    pausa()
def v_uc():
    c=elegir()
    if c<0:
        return
    print()
    print("Uc-"+NOM[c]+" (mm)")
    sep()
    print("Mes  K    Uc(mm)")
    sep()
    for m in range(12):
        a=lj(MESES[m],4)
        b=rj(flt(K[c][m],2),4)
        cv=rj(flt(Uc(c,m),2),7)
        print(a+" "+b+" "+cv)
    pausa()
def v_dn():
    c=elegir()
    if c<0:
        return
    print()
    print("DN-"+NOM[c]+" (mm)")
    sep()
    print("Mes  Pef   DN")
    sep()
    for m in range(12):
        a=lj(MESES[m],4)
        b=rj(flt(Pef(m),2),6)
        cv=rj(flt(DN(c,m),2),7)
        print(a+" "+b+" "+cv)
    pausa()
def v_qc():
    c=elegir()
    if c<0:
        return
    print()
    print("Q-"+NOM[c]+" (lps)")
    sep()
    print("Mes   Q(lps)")
    sep()
    for m in range(12):
        a=lj(MESES[m],4)
        q=Qc(c,m)*1000
        b=rj(flt(q,5),9)
        print(a+"  "+b)
    pausa()
def v_res():
    print()
    print("RESUMEN MENSUAL")
    sep()
    print("Mes  Qbrut Qreq(lps)")
    sep()
    for m in range(12):
        a=lj(MESES[m],4)
        qt=Qt(m)*1000
        qr=Qr(m)*1000
        b=rj(flt(qt,2),6)
        cv=rj(flt(qr,2),6)
        mk=" "
        if qr>0:
            mk="*"
        print(a+" "+b+" "+cv+mk)
    sep()
    print("*=estiaje")
    pausa()
def v_qmax():
    Qmax=0.0
    mm=0
    for m in range(12):
        qr=Qr(m)
        if qr>Qmax:
            Qmax=qr
            mm=m
    print()
    print("CAUDAL MAX Y DISENO")
    sep()
    s="Qmax="+flt(Qmax,6)
    print(s+" m3/s")
    s="    ="+flt(Qmax*1000,3)
    print(s+" lps")
    print("Mes: "+MESES[mm])
    sep()
    print("Asumir Q=20 lps")
    s="Irriga "+str(int(AT))+" Ha"
    print(s)
    sep()
    print("Estiaje (Q>0):")
    for m in range(12):
        qr=Qr(m)
        if qr>0:
            s=" "+MESES[m]+": "
            s+=flt(qr*1000,3)
            s+=" lps"
            print(s)
    pausa()
menu()
